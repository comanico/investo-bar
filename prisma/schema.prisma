generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model menu {
  id       Int     @id @default(autoincrement())
  product  String  @db.VarChar(255)
  type     String  @db.VarChar(255)
  price    Decimal @db.Decimal(10, 2)
  quantity Int?    @default(0)
}

model sales {
  id       Int      @id @default(autoincrement())
  product  String   @db.VarChar(255)
  type     String   @db.VarChar(255)
  price    Decimal  @db.Decimal(10, 2)
  quantity Int?     @default(0)
  username String   @db.VarChar(255) @default("Spender Investobar")
  time     DateTime @default(now())
}

model bere {
  id       Int @id @default(autoincrement())
  Heineken Int @default(0)
  Corona   Int @default(0)
  Peroni   Int @default(0)
}

model vin {
  id          Int @id @default(autoincrement())
  Aperol_Spritz      Int @default(0)
  Vin_Alb     Int @default(0)
  Vin_Rosu    Int @default(0)
  Prosecco    Int @default(0)
}

model racoritoare {
  id           Int @id @default(autoincrement())
  Apa          Int @default(0)
  Cola         Int @default(0)
}
