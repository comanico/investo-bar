generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model menu {
  id       Int     @id @default(autoincrement())
  product  String  @db.VarChar(255)
  type     String  @db.VarChar(255)
  price    Decimal @db.Decimal(10, 2)
  quantity Int?    @default(0)
}

model sales {
  id       Int      @id @default(autoincrement())
  product  String   @db.VarChar(255)
  type     String   @db.VarChar(255)
  price    Decimal  @db.Decimal(10, 2)
  quantity Int?     @default(0)
  username String   @default("Spender Investobar") @db.VarChar(255)
  time     DateTime @default(now())
}

model bere {
  id       Int @id @default(autoincrement())
  Heineken Int @default(0)
  Corona   Int @default(0)
  Peroni   Int @default(0)
}

model vin {
  id            Int @id @default(autoincrement())
  Aperol_Spritz Int @default(0)
  Vin_Alb       Int @default(0)
  Vin_Rosu      Int @default(0)
  Prosecco      Int @default(0)
}

model racoritoare {
  id                      Int @id @default(autoincrement())
  Vin_Spumant_Fara_Alcool Int @default(0)
  Apa                     Int @default(0)
  Cola                    Int @default(0)
}

model spirtoase {
  id                   Int @id @default(autoincrement())
  Jameson              Int @default(0)
  Jameson_Black_Barrel Int @default(0)
  Fireball             Int @default(0)
  Tequilla             Int @default(0)
}

model Placement {
  id           String         @id @default(cuid())
  venueId      String
  kind         String
  label        String
  token        String         @unique
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  orders       Order[]
  lots         PortfolioLot[]

  @@index([venueId, active])
  @@map("placement")
}

model Order {
  id          String    @id @default(cuid())
  placementId String
  placement   Placement @relation(fields: [placementId], references: [id])
  product     String
  type        String
  price       Float
  qty         Int       @default(1)
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  @@index([status, createdAt])
  @@index([placementId])
  @@map("orders")
}

model PortfolioLot {
  id              String    @id @default(cuid())
  placementId     String
  placement       Placement @relation(fields: [placementId], references: [id])
  placementLabel  String
  product         String
  qty             Int
  unitPrice       Decimal   @db.Decimal(10, 2)
  createdAt       DateTime  @default(now())
  sessionDate     DateTime  @db.Date

  @@index([placementId, sessionDate])
  @@index([product])
  @@map("portfoliolot")
}